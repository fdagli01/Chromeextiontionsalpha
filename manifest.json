{
  "manifest_version": 3,
  "name": "Polyglot Chronicle",
  "description": "Dil, tarih ve felsefeyi birleştiren tema tabanlı bir kelime öğrenme eklentisi",
  "version": "0.2.1",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Polyglot Chronicle"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "storage", "activeTab", "notifications"],
  "host_permissions": ["https://api.mymemory.translated.net/*"],
  "icons": {
    "16": "src/assets/images/icon16.png",
    "48": "src/assets/images/icon48.png",
    "128": "src/assets/images/icon128.png"
  }
}
